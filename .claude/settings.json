{
  "permissions": {
    "allow": [
      "Bash(mkdir -p docs/*)",
      "Bash(cp * docs/*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin:*)",
      "Bash(gh pr create:*)"
    ],
    "deny": [
      "Edit(data/**)",
      "Write(data/**)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Bash(sed -i:*)",
      "Bash(tee:*)",
      "Bash(cp * data/*)",
      "Bash(cp * ./data/*)",
      "Bash(cp * */data/*)",
      "Bash(mv:*)",
      "Bash(rm:*)"
    ]
  }
}
